---
import Layout from "./Layout.astro";
import Inner from "./MdWrap/inner.astro";
const { withoutLayout } = Astro.props;
const fab = Astro.props.fab ?? Astro.props.frontmatter?.fab;
console.log(fab);
---

{
  !withoutLayout ? (
    <Layout>
      <Inner fab={fab}>
        <slot />
      </Inner>
    </Layout>
  ) : (
    <Inner fab={fab}>
      <slot />
    </Inner>
  )
}
