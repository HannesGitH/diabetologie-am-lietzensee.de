---
import '../styles/global.css';

const currentPath = Astro.url.pathname;

// TODO: dynamic
// const pages = Object.values(import.meta.glob('../pages/**.astro', { eager: true }));
// const links = pages.map((page: any) => {console.log({url:page.url, file: page.file})}).flat()

const links = [
  { href: "/", text: "Willkommen" },
  { href: "/contact", text: "Kontakt" },
  { href: "/team", text: "Das Team" },
  { href: "/services", text: "Leistungen" },
  { href: "/impress", text: "Impressum" },
]
.map((link) => {
  const isActive = currentPath === link.href;
  return { ...link, isActive };
});
---

<nav>
  <ul>
    <!--
        For each link in the links array, render a list item with a link to the href.
        If the link is active, add the 'active' class to the list item.
        -->
    {
      links.map((link) => (
        <li class:list={[{ active: link.isActive }]}>
          <a href={link.href}>{link.text}</a>
        </li>
      ))
    }
  </ul>
  <button aria-label="Toggle Menu" >☰</button>
</nav>

<script>
    const nav = document.querySelector('nav')!;
    const button = nav.querySelector('button')!;
    const ul = nav.querySelector('ul')!;
    
    button.addEventListener('click', () => {
        ul.classList.toggle('open');
        button.innerHTML = ul.classList.contains('open') ? '✖' : '☰';
    });
</script>


<style>
nav {
    background-color: var(--primary-container);
    color: var(--on-primary-container);
    margin-top: 0;
    padding-top: 0;
    font-size: x-large;
    font-weight: 600;
    clip: auto;
    position: sticky;
    top: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

button {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--on-primary-container);
    padding: 0.5rem;
}

@media (max-width: 900px) {
    ul {
        flex-direction: column;
        align-items: start;
    }

    button {
        display: block;
    }

    ul:not(.open) li:not(.active) {
        /* display: none; */
        height: 0;
        padding: 0;
        margin: 0;
        border: none;
        clip: auto;
        opacity: 0;
    }
    
    nav:has(ul.open) {
        align-items: end;
    }
}

  ul {
    display: flex;
    justify-content: space-around;
    list-style: none;
    padding: 0;
    margin: 0;
    padding: .7rem;
  }

  li {
    transition: all 0.3s;
    padding: 0.5rem 1.5rem;
    padding-top: 0.4rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  li.active {
    border-radius: 9999px;
    /* background:
			linear-gradient(66.77deg, var(--primary), var(--primary)) padding-box,
			linear-gradient(155deg, #6733d8 0%, #6141ff 18%, var(--primary-container) 45%) border-box;
    border: 1px solid transparent; */
    background-color: var(--primary-container-variant);
    /* box-shadow: 0 0 1rem var(--primary), 0 0 .5rem var(--primary); */
    text-shadow: 0 0 1rem var(--primary), 0 0 .5rem var(--primary), 0 0 1.5rem var(--primary);
  }

  li:hover:not(.active) {
    text-shadow: 0 0 3rem var(--on-primary);
  }

</style>